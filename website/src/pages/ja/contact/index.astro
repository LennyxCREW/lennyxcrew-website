---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout language="ja" title="Contact" description="LennyxCREWとの対話が、静かに始まる場所。">
  <section class="contact-space" data-contact-space aria-labelledby="contact-title">
    <div class="star-field" aria-hidden="true"></div>
    <div class="horizon" aria-hidden="true"></div>

    <div class="contact-intro">
      <h1 id="contact-title"><span>対話は、</span><span>ここから始まります。</span></h1>
      <span class="intro-line" aria-hidden="true"><i></i></span>
      <p>言葉になった想いも、<br />まだ言葉にならない想いも。</p>
      <p>ここから、聞かせてください。</p>
    </div>

    <div class="meeting-light" aria-hidden="true">
      <svg viewBox="0 0 700 500" role="presentation">
        <defs>
          <filter id="blue-glow" x="-80%" y="-80%" width="260%" height="260%">
            <feGaussianBlur stdDeviation="13" result="blur" />
            <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
          </filter>
          <filter id="gold-glow" x="-80%" y="-80%" width="260%" height="260%">
            <feGaussianBlur stdDeviation="11" result="blur" />
            <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
          </filter>
          <linearGradient id="blue-line" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#194fab" stop-opacity="0" />
            <stop offset=".7" stop-color="#53a8ff" stop-opacity=".84" />
            <stop offset="1" stop-color="#e8f7ff" />
          </linearGradient>
          <linearGradient id="gold-line" x1="1" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#b65d20" stop-opacity="0" />
            <stop offset=".72" stop-color="#ffc56d" stop-opacity=".8" />
            <stop offset="1" stop-color="#fff6dc" />
          </linearGradient>
        </defs>
        <g class="blue-light" filter="url(#blue-glow)">
          <path d="M40 22 C118 102 135 175 212 210 C282 242 320 246 342 270" />
          <path class="fine" d="M7 72 C115 119 151 191 226 221 C286 244 315 253 341 271" />
        </g>
        <g class="gold-light" filter="url(#gold-glow)">
          <path d="M672 110 C585 130 535 184 467 217 C410 245 380 250 359 271" />
          <path class="fine" d="M700 57 C606 114 559 181 474 219 C417 245 385 254 360 271" />
        </g>
        <circle class="blue-core" cx="345" cy="272" r="3.5" />
        <circle class="gold-core" cx="356" cy="272" r="3.5" />
      </svg>
    </div>

    <div class="form-region">
      <form class="contact-form" data-contact-form novalidate>
        <div class="field">
          <label for="contact-name">あなたを、なんとお呼びすればいいですか？</label>
          <p class="field-note">本名でなくても大丈夫です。</p>
          <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="80" required placeholder="呼ばれたい名前" />
        </div>

        <div class="field">
          <label for="contact-email">メールアドレス</label>
          <p class="field-note">返信のために使用します。</p>
          <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required placeholder="you@example.com" />
        </div>

        <div class="field">
          <label for="contact-message">何から話しましょうか？</label>
          <textarea id="contact-message" name="message" rows="5" maxlength="5000" required placeholder="ここから、聞かせてください。"></textarea>
        </div>

        <div class="trap" aria-hidden="true">
          <label for="contact-website">Webサイト</label>
          <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit"><span>思いを届ける</span><span aria-hidden="true">→</span></button>
        <p class="privacy">お預かりした情報は、ご連絡への返信のために使用します。</p>
        <p class="form-error" data-form-error role="alert" hidden><strong>うまく届けられませんでした。</strong><br />少し時間をおいて、もう一度お試しください。</p>
      </form>

      <div class="success-message" data-success-message aria-live="polite" tabindex="-1" hidden>
        <p><strong>ありがとう。</strong><br />あなたの思いを受け取りました。</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const space = document.querySelector<HTMLElement>('[data-contact-space]');
  const errorMessage = document.querySelector<HTMLElement>('[data-form-error]');
  const successMessage = document.querySelector<HTMLElement>('[data-success-message]');

  const showSuccess = () => {
    if (!form) return;
    form.hidden = true;
    successMessage?.removeAttribute('hidden');
    space?.classList.add('is-received');
    successMessage?.focus();
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorMessage?.setAttribute('hidden', '');

    if (!form.reportValidity()) return;

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const data = Object.fromEntries(new FormData(form).entries());
    if (button) {
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
    }

    // Astroの開発サーバーではメールを送らず、成功後の空間だけを確認します。
    if (['localhost', '127.0.0.1'].includes(window.location.hostname)) {
      window.setTimeout(() => {
        showSuccess();
        if (button) {
          button.disabled = false;
          button.removeAttribute('aria-busy');
        }
      }, 650);
      return;
    }

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await response.json().catch(() => null);
      if (!response.ok || !result?.ok) throw new Error('Delivery failed');

      showSuccess();
    } catch {
      errorMessage?.removeAttribute('hidden');
    } finally {
      if (button) {
        button.disabled = false;
        button.removeAttribute('aria-busy');
      }
    }
  });
</script>

<style>
  :global(body) { background: #040815; }
  :global(.site-header) { position: relative; z-index: 10; border-bottom-color: rgb(255 255 255 / 10%); }
  :global(main) { width: 100%; max-width: none; }

  .contact-space {
    position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(17rem, .95fr) minmax(15rem, .9fr) minmax(22rem, 1.18fr);
    align-items: center; gap: clamp(1.5rem, 3vw, 4.5rem); min-height: calc(100svh - 5rem); overflow: hidden;
    padding: clamp(3.5rem, 7vh, 6.5rem) max(4vw, calc((100vw - 86rem) / 2));
    color: #f3f0ea; font-family: Georgia, 'Times New Roman', 'Yu Mincho', 'Hiragino Mincho ProN', serif;
    background:
      radial-gradient(circle at 49% 31%, rgb(68 56 148 / 23%), transparent 24%),
      radial-gradient(circle at 16% 72%, rgb(15 72 135 / 22%), transparent 33%),
      radial-gradient(circle at 88% 74%, rgb(130 68 28 / 12%), transparent 31%),
      linear-gradient(180deg, #060919 0%, #071127 50%, #050916 100%);
  }
  .contact-space::before {
    content: ''; position: absolute; z-index: -2; inset: 0; pointer-events: none; opacity: .56;
    background-image:
      radial-gradient(circle, rgb(205 226 255 / 84%) 0 1px, transparent 1.4px),
      radial-gradient(circle, rgb(126 169 239 / 55%) 0 .8px, transparent 1.2px),
      radial-gradient(circle, rgb(255 226 177 / 45%) 0 .7px, transparent 1.1px);
    background-position: 0 0, 47px 83px, 113px 29px; background-size: 139px 131px, 191px 179px, 239px 211px;
    mask-image: linear-gradient(to bottom, #000 0 64%, transparent 94%);
  }
  .contact-space::after {
    content: ''; position: absolute; z-index: -1; inset: 0; pointer-events: none;
    background: linear-gradient(90deg, rgb(0 0 0 / 31%), transparent 21%, transparent 77%, rgb(0 0 0 / 22%)), linear-gradient(180deg, transparent 64%, rgb(1 4 11 / 78%));
  }
  .horizon { position: absolute; z-index: -1; inset: auto 0 0; height: 29%; opacity: .7; background: radial-gradient(ellipse at 52% 120%, rgb(26 80 137 / 48%), transparent 58%), linear-gradient(169deg, transparent 0 30%, #071127 30.3% 39%, transparent 39.3%) 0 0 / 43rem 100%, linear-gradient(191deg, transparent 0 32%, #081020 32.3% 42%, transparent 42.3%) 21rem 0 / 46rem 100%; }
  .star-field { position: absolute; z-index: -1; inset: 0; box-shadow: inset 0 0 10rem rgb(0 0 0 / 55%); pointer-events: none; }

  .contact-intro { align-self: center; max-width: 28rem; text-shadow: 0 2px 1rem rgb(0 0 0 / 75%); }
  .contact-intro h1 { margin: 0; font-size: clamp(2rem, 2.55vw, 3rem); font-weight: 400; line-height: 1.42; letter-spacing: .045em; overflow-wrap: normal; }
  .contact-intro h1 span { display: block; white-space: nowrap; overflow-wrap: normal; word-break: keep-all; }
  .contact-intro p { margin: 0; color: rgb(236 238 246 / 88%); font-size: clamp(1rem, 1.15vw, 1.22rem); line-height: 2.05; letter-spacing: .055em; }
  .contact-intro p + p { margin-top: .25rem; }
  .intro-line { position: relative; display: block; width: min(100%, 21rem); height: 1px; margin: 2rem 0 1.8rem; background: linear-gradient(90deg, #ead6a8, rgb(234 214 168 / 20%), transparent); }
  .intro-line i { position: absolute; top: 50%; left: 38%; width: .45rem; height: .45rem; background: #fff6db; box-shadow: 0 0 .75rem #ffd98b; transform: translate(-50%, -50%) rotate(45deg); }

  .meeting-light { position: relative; align-self: stretch; min-height: 30rem; pointer-events: none; }
  .meeting-light svg { position: absolute; top: 50%; left: 50%; width: min(47vw, 49rem); max-width: none; transform: translate(-50%, -50%); overflow: visible; }
  .blue-light path, .gold-light path { fill: none; stroke-width: 3.2; stroke-linecap: round; }
  .blue-light path { stroke: url('#blue-line'); }
  .gold-light path { stroke: url('#gold-line'); }
  .blue-light .fine, .gold-light .fine { stroke-width: 1; opacity: .7; }
  .blue-core { fill: #edfaff; filter: drop-shadow(0 0 12px #4ca8ff); }
  .gold-core { fill: #fff8e7; filter: drop-shadow(0 0 12px #ffb851); }

  .form-region { position: relative; z-index: 2; width: 100%; max-width: 32rem; justify-self: end; }
  .contact-form { display: grid; gap: 1.35rem; }
  .contact-form[hidden], .success-message[hidden] { display: none; }
  .field label { display: block; margin-bottom: .2rem; font-size: .99rem; letter-spacing: .045em; }
  .field-note { margin: 0 0 .5rem; color: rgb(199 210 229 / 66%); font-family: system-ui, sans-serif; font-size: .76rem; line-height: 1.5; }
  .field input, .field textarea {
    width: 100%; border: 1px solid rgb(172 192 225 / 28%); border-radius: .55rem; outline: none;
    padding: .92rem 1rem; color: #f4f6fb; background: linear-gradient(105deg, rgb(41 57 92 / 47%), rgb(20 30 60 / 58%));
    box-shadow: inset 0 0 1.8rem rgb(83 120 184 / 5%), 0 .6rem 2rem rgb(0 0 0 / 10%);
    backdrop-filter: blur(8px); font: 400 1rem/1.6 system-ui, sans-serif; transition: border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }
  .field textarea { min-height: 8.2rem; resize: vertical; }
  .field input::placeholder, .field textarea::placeholder { color: rgb(194 205 225 / 46%); }
  .field input:hover, .field textarea:hover { border-color: rgb(190 210 242 / 42%); }
  .field input:focus, .field textarea:focus { border-color: rgb(153 202 255 / 72%); box-shadow: 0 0 0 3px rgb(83 159 235 / 12%), inset 0 0 2rem rgb(63 130 205 / 8%); }
  .trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  button {
    position: relative; display: flex; align-items: center; justify-content: center; gap: 1.1rem; min-height: 3.6rem; width: 100%; overflow: hidden;
    border: 1px solid rgb(225 216 194 / 58%); border-radius: 99rem; color: #f8f4eb; cursor: pointer;
    background: linear-gradient(90deg, rgb(15 78 148 / 43%), rgb(37 43 82 / 54%) 50%, rgb(130 80 28 / 38%));
    box-shadow: -1rem 0 2.5rem rgb(51 150 255 / 9%), 1rem 0 2.5rem rgb(255 183 74 / 8%);
    font: 400 1.05rem/1 Georgia, 'Yu Mincho', serif; letter-spacing: .08em; transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }
  button:hover, button:focus-visible { transform: translateY(-1px); border-color: rgb(255 242 211 / 86%); box-shadow: -1.2rem 0 3rem rgb(51 150 255 / 17%), 1.2rem 0 3rem rgb(255 183 74 / 15%); }
  button:focus-visible { outline: 2px solid #f3d99e; outline-offset: 4px; }
  button:disabled { cursor: wait; opacity: .62; transform: none; }
  .privacy { margin: -.55rem 0 0; color: rgb(197 205 219 / 60%); font: 400 .72rem/1.7 system-ui, sans-serif; text-align: center; }
  .form-error { margin: -.25rem 0 0; padding: .75rem 1rem; border-left: 2px solid rgb(255 178 139 / 72%); color: #f4ddd5; background: rgb(84 28 25 / 18%); font: 400 .88rem/1.75 system-ui, sans-serif; }
  .success-message { padding: 4rem 1rem; text-align: center; }
  .success-message p { margin: 0; color: rgb(240 242 249 / 92%); font-size: clamp(1.08rem, 1.6vw, 1.32rem); line-height: 2.2; letter-spacing: .07em; }
  .success-message strong { color: #fff9eb; font-size: 1.35em; font-weight: 400; }

  .is-received .blue-light, .is-received .gold-light { animation: answer-light 1.3s ease-out 1; }
  .is-received .blue-core, .is-received .gold-core { animation: answer-core 1.3s ease-out 1; }
  @keyframes answer-light { 0%, 100% { opacity: 1; } 48% { opacity: .65; } 62% { opacity: 1; } }
  @keyframes answer-core { 0%, 100% { transform: scale(1); } 55% { transform: scale(2.15); } }

  @media (max-width: 64rem) {
    .contact-space { grid-template-columns: minmax(15rem, .9fr) minmax(14rem, .65fr) minmax(20rem, 1.1fr); gap: 1.5rem; padding-inline: 3vw; }
    .meeting-light svg { width: 54vw; }
  }

  @media (max-width: 48rem) {
    .contact-space { display: flex; flex-direction: column; align-items: stretch; min-height: auto; padding: 4rem 1.25rem 5rem; }
    .contact-intro { width: min(100%, 32rem); margin-inline: auto; }
    .contact-intro h1 { font-size: clamp(1.7rem, 8.35vw, 2.65rem); line-height: 1.45; }
    .contact-intro p { font-size: 1rem; }
    .intro-line { margin-block: 1.7rem 1.5rem; }
    .meeting-light { order: 2; width: 100%; min-height: 18rem; margin: .25rem 0 -.4rem; }
    .meeting-light svg { width: min(135vw, 42rem); }
    .form-region { order: 3; width: min(100%, 34rem); max-width: none; margin-inline: auto; }
    .contact-form { gap: 1.55rem; }
    .field label { font-size: 1rem; line-height: 1.65; }
    .field input, .field textarea { min-height: 3.3rem; font-size: 1rem; }
    button { min-height: 3.75rem; margin-top: .15rem; }
    .horizon { height: 45%; opacity: .42; }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-received .blue-light, .is-received .gold-light, .is-received .blue-core, .is-received .gold-core { animation: none; }
  }
</style>
