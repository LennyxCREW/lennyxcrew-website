---
import { getEntry, render } from 'astro:content';
import type { Language } from '../i18n/config';
import DocumentLayout from '../layouts/DocumentLayout.astro';

interface Props {
  language: Language;
  slug: 'about' | 'manifesto' | 'credo';
  title: string;
}

const { language, slug, title } = Astro.props;
const entry = await getEntry('pages', `${language}/${slug}`);

if (!entry) {
  throw new Error(`Missing official content: ${language}/${slug}`);
}

const { Content } = await render(entry);
---

<DocumentLayout language={language} title={title}>
  <Content />
</DocumentLayout>
