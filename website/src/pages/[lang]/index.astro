---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalizedPath, languages, type Language } from '../../i18n/config';
import { ui } from '../../i18n/ui';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { language: lang } }));
}

interface Props {
  language: Language;
}

const { language } = Astro.props;
const labels = ui[language];
---

<BaseLayout language={language} title="LennyxCREW">
  <section class="hero">
    <p class="eyebrow">LennyxCREW</p>
    <h1>{labels.homeTitle}</h1>
    <p>{labels.homeLead}</p>
    <a class="text-link" href={getLocalizedPath(language, 'about')}>{labels.homeLink}</a>
  </section>
</BaseLayout>
