---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalizedPath, languages, type Language } from '../../i18n/config';
import { ui } from '../../i18n/ui';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { language: lang } }));
}

interface Props {
  language: Language;
}

const { language } = Astro.props;
const labels = ui[language];
---

<BaseLayout language={language} title="LennyxCREW">
  <section class="hero home-hero">
    <div class="home-hero__content">
      <p class="eyebrow">LennyxCREW</p>
      <h1>
        {
          language === 'ja' ? (
            <>
              <span class="home-title--desktop">一人では辿り着けない未来を<br />人とAIで</span>
              <span class="home-title--mobile">{labels.homeTitle}</span>
            </>
          ) : (
            <>
              <span class="home-title--desktop">
                Beyond what we can reach alone—<br />together, Human and AI.
              </span>
              <span class="home-title--mobile">{labels.homeTitle}</span>
            </>
          )
        }
      </h1>
      <p>{labels.homeLead}</p>
      <a class="text-link home-hero__link" href={getLocalizedPath(language, 'about')}>
        {labels.homeLink}<span aria-hidden="true">&#8594;</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    width: 100vw;
    max-width: none;
    min-height: calc(100vh - 5rem);
    min-height: calc(100svh - 5rem);
    margin-left: calc(50% - 50vw);
    padding: clamp(4rem, 10vh, 8rem) max(1.5rem, calc((100vw - 76rem) / 2));
    overflow: hidden;
    background:
      linear-gradient(90deg, rgb(3 10 12 / 88%) 0%, rgb(4 12 13 / 65%) 42%, rgb(4 12 13 / 12%) 72%),
      linear-gradient(0deg, rgb(3 9 11 / 48%) 0%, transparent 42%),
      #030a0c url('/images/home-hero-forest-door.jpg') 72% center / auto 112% no-repeat;
  }

  .home-hero::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    border: 1px solid rgb(224 217 178 / 12%);
    content: '';
    pointer-events: none;
  }

  .home-hero__content {
    width: min(100%, 46rem);
    padding: clamp(1.5rem, 4vw, 3rem) 0;
    text-shadow: 0 2px 24px rgb(0 0 0 / 65%);
  }

  .home-hero .eyebrow {
    color: #ded8b7;
    font-size: 0.78rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 44rem;
    color: #f5f2e8;
    font-family: Georgia, 'Times New Roman', 'Yu Mincho', 'Hiragino Mincho ProN', serif;
    font-size: clamp(2.4rem, 6vw, 5.2rem);
    font-weight: 400;
    line-height: 1.22;
  }

  .home-hero__content > p:not(.eyebrow) {
    max-width: 38rem;
    color: #e1e4da;
  }

  .home-title--mobile {
    display: none;
  }

  .home-hero__link {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid rgb(234 225 187 / 70%);
    color: #f1e9ca;
    text-decoration: none;
    transition: gap 180ms ease, border-color 180ms ease;
  }

  .home-hero__link:hover {
    gap: 1.2rem;
    border-color: #f1e9ca;
  }

  @media (min-width: 48.0625rem) {
    .home-title--mobile {
      display: none !important;
    }

    :global(html[lang='ja']) .home-hero .eyebrow {
      font-size: 1.4rem;
      letter-spacing: 0.16em;
      text-transform: none;
    }

    :global(html[lang='en']) .home-hero .eyebrow {
      font-size: 1.4rem;
      text-transform: none;
    }

    :global(html[lang='en']) .home-hero h1 {
      max-width: 46rem;
      font-size: clamp(2.25rem, 3.7vw, 3.4rem);
    }

    :global(html[lang='ja']) .home-hero h1 {
      max-width: 50rem;
      font-size: clamp(2.4rem, 3.8vw, 3.5rem);
    }

    :global(html[lang='ja']) .home-title--desktop {
      white-space: nowrap;
    }
  }

  @media (max-width: 48rem) {
    .home-title--desktop {
      display: none;
    }

    .home-title--mobile {
      display: inline;
    }

    .home-hero {
      padding-inline: 1rem;
      background:
        linear-gradient(0deg, rgb(3 10 12 / 88%) 0%, rgb(3 10 12 / 38%) 68%, rgb(3 10 12 / 18%) 100%),
        url('/images/home-hero-forest-door.jpg') 58% center / cover no-repeat;
    }

    .home-hero__content {
      align-self: end;
      padding-bottom: clamp(2rem, 8vh, 5rem);
    }

    .home-hero h1 {
      font-size: clamp(2.25rem, 11vw, 3.8rem);
    }
  }
</style>
